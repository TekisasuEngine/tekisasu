#include "core/version.h"

#ifndef RT_MANIFEST
#define RT_MANIFEST 24
#endif

TEKISASU_ICON ICON platform/windows/tekisasu.ico
1 RT_MANIFEST "platform/windows/tekisasu.manifest"

1 VERSIONINFO
// Using external version for user-facing Windows properties
FILEVERSION     EXTERNAL_VERSION_MAJOR,EXTERNAL_VERSION_MINOR,EXTERNAL_VERSION_PATCH,0
PRODUCTVERSION  EXTERNAL_VERSION_MAJOR,EXTERNAL_VERSION_MINOR,EXTERNAL_VERSION_PATCH,0
FILEOS          4
FILETYPE        1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",            "Tekisasu Engine"
            VALUE "FileDescription",        VERSION_NAME
            VALUE "FileVersion",            EXTERNAL_VERSION_NUMBER
            VALUE "ProductName",            VERSION_NAME
            VALUE "Licence",                "MIT"
            VALUE "LegalCopyright",         "(c) 2021-present Tekisasu. (c) 2024-present Blazium Engine contributors, 2007-present Juan Linietsky, Ariel Manzur and Godot Engine contributors, (c) 2024-present Redot Engine contributors."
            VALUE "Info",                   "https://dev.tekisasu.com"
            VALUE "ProductVersion",         EXTERNAL_VERSION_FULL_CONFIG
            VALUE "TekisasuRelease",        TEKISASU_RELEASE
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
